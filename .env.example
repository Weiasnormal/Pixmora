# Feedback emails, sent through Resend (https://resend.com).
# Copy these into .env.local for local testing, and into Vercel's Environment Variables for the live site.
# Never commit real values.

# API key from the Resend dashboard.
RESEND_API_KEY=

# The inbox that receives feedback.
FEEDBACK_TO_EMAIL=

# Optional. The ID of your published "Pixmora feedback" template in Resend.
# Leave empty to send a plain-text email instead.
RESEND_TEMPLATE_ID=

# Optional sender. Leave empty to use Resend's test sender, which only delivers to your own Resend account email.
# Once you verify a domain in Resend, use something like: Pixmora feedback <feedback@yourdomain.com>
FEEDBACK_FROM_EMAIL=
